// AKWABA FC — schéma de données de la plateforme
//
// Provider Postgres (compatible Vercel + Neon/Supabase/Vercel Postgres).
// DATABASE_URL doit pointer vers une instance Postgres — voir .env.example
// et README.md pour la configuration locale (Neon gratuit) et Vercel.
//
// Aucune valeur "enum" Prisma n'est utilisée ici : les catégories/rôles/
// statuts sont modélisés en String et validés côté application (voir
// lib/constants.ts) — un choix delibéré qui garde le schéma portable
// (utile si un jour on change de fournisseur Postgres) et qui permettra de
// les promouvoir en vrais enums Postgres plus tard si souhaité.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ACCÈS & ADMINISTRATION
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // SUPER_ADMIN | ADMIN | EDITOR | SPORT_MANAGER | ACADEMY_MANAGER | MEDIA_MANAGER
  avatarUrl    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique // histoire | identite | valeurs | palmares | stade | infrastructures | gouvernance
  title     String
  subtitle  String?
  blocks    Json // bloc de contenu riche [{type:'text'|'image'|'stat', ...}]
  updatedAt DateTime @updatedAt
}

model HonourTitle {
  id          String @id @default(cuid())
  title       String
  season      String
  competition String
  order       Int    @default(0)
}

// ---------------------------------------------------------------------------
// CLUB / ÉQUIPES / EFFECTIFS
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  slug        String   @unique // men | women | reserve | u18
  name        String
  shortName   String
  tagline     String?
  description String?
  coverImage  String?
  createdAt   DateTime @default(now())

  players Player[]
  staff   StaffMember[]
  matches Match[]
  news    NewsArticle[] @relation("TeamNews")
}

model Player {
  id             String   @id @default(cuid())
  slug           String   @unique
  firstName      String
  lastName       String
  number         Int
  position       String // GK | DEF | MID | FWD
  birthDate      DateTime
  nationality    String
  height         Int? // cm
  preferredFoot  String? // GAUCHE | DROIT | AMBIDEXTRE
  photoUrl       String?
  bio            String?
  captain        Boolean  @default(false)
  appearances    Int      @default(0)
  goals          Int      @default(0)
  assists        Int      @default(0)
  minutes        Int      @default(0)
  yellowCards    Int      @default(0)
  redCards       Int      @default(0)
  joinedAt       DateTime @default(now())
  active         Boolean  @default(true)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  careerSteps PlayerCareerStep[]

  @@index([teamId])
}

model PlayerCareerStep {
  id       String @id @default(cuid())
  season   String
  club     String
  note     String?
  order    Int    @default(0)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model StaffMember {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  role       String
  department String // DIRECTION | MEN | WOMEN | RESERVE | U18 | ACADEMY | MEDIA
  photoUrl   String?
  bio        String?
  order      Int     @default(0)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// COMPÉTITIONS / MATCHS / CLASSEMENTS
// ---------------------------------------------------------------------------

model Competition {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  season String

  matches  Match[]
  standing StandingEntry[]
}

model Match {
  id         String    @id @default(cuid())
  opponent   String
  opponentLogo String?
  isHome     Boolean   @default(true)
  date       DateTime
  stadium    String
  matchday   String?
  status     String    @default("SCHEDULED") // SCHEDULED | LIVE | FINISHED | POSTPONED
  homeScore  Int?
  awayScore  Int?
  summary    String?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  events        MatchEvent[]
  ticketOffers  TicketOffer[]
  galleryImages GalleryImage[]

  @@index([teamId])
  @@index([competitionId])
}

model MatchEvent {
  id     String @id @default(cuid())
  minute Int
  type   String // GOAL | YELLOW | RED | SUB | OTHER
  side   String // HOME | AWAY
  player String
  detail String?
  order  Int    @default(0)

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model StandingEntry {
  id       String @id @default(cuid())
  club     String
  isClub   Boolean @default(false)
  category String // men | women | reserve | u18
  position Int
  played   Int    @default(0)
  won      Int    @default(0)
  drawn    Int    @default(0)
  lost     Int    @default(0)
  goalsFor Int    @default(0)
  goalsAgainst Int @default(0)
  points   Int    @default(0)

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, category])
}

// ---------------------------------------------------------------------------
// ACTUALITÉS
// ---------------------------------------------------------------------------

model NewsArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  category    String // EQUIPE_PREMIERE | FEMININES | RESERVE | U18 | ACADEMY | MERCATO | INTERVIEWS | COMMUNIQUES | VIE_DU_CLUB | SUPPORTERS | PARTENAIRES
  coverImage  String
  blocks      Json // [{type:'text'|'image'|'video'|'gallery'|'quote', ...}]
  tags        Json // string[]
  author      String
  featured    Boolean  @default(false)
  publishedAt DateTime @default(now())

  teamId String?
  team   Team?  @relation("TeamNews", fields: [teamId], references: [id], onDelete: SetNull)

  @@index([category])
}

// ---------------------------------------------------------------------------
// CLUB TV / GALERIE
// ---------------------------------------------------------------------------

model Video {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String?
  category      String // MATCHS | CONFERENCES | INTERVIEWS | INSIDE | TRAINING | ACADEMY_TV | FEMININE_TV | HIGHLIGHTS | DOCUMENTAIRES | MAGAZINE
  thumbnailUrl  String
  videoUrl      String
  durationSeconds Int
  isLive        Boolean  @default(false)
  publishedAt   DateTime @default(now())
}

model GalleryImage {
  id          String   @id @default(cuid())
  url         String
  caption     String?
  category    String // MATCHS | ENTRAINEMENTS | FEMININES | RESERVE | U18 | ACADEMY | SUPPORTERS | EVENEMENTS
  publishedAt DateTime @default(now())

  matchId String?
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// SUPPORTERS / BILLETTERIE / BOUTIQUE / PARTENAIRES
// ---------------------------------------------------------------------------

model SupporterGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  since       String?
  membersLabel String?
}

model SupporterEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
}

model TicketOffer {
  id        String @id @default(cuid())
  tier      String // TRIBUNE_A | TRIBUNE_B | VIP | FAMILLE
  price     Int // en FCFA
  capacity  Int
  remaining Int

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  orders TicketOrder[]
}

model TicketOrder {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  phone          String
  quantity       Int
  status         String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  paymentProvider String?
  paymentRef     String?
  createdAt      DateTime @default(now())

  ticketOfferId String
  ticketOffer   TicketOffer @relation(fields: [ticketOfferId], references: [id], onDelete: Cascade)
}

model ShopProduct {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  category    String // MAILLOTS | SHORTS | SURVETEMENTS | ECHARPES | CASQUETTES | ACCESSOIRES | SUPPORTERS
  price       Int
  imageUrl    String
  description String?
  sizes       Json // string[]
  inStock     Boolean @default(true)
}

model ShopOrder {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  address     String
  items       Json // [{productId,name,size,quantity,price}]
  total       Int
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  createdAt   DateTime @default(now())
}

model Partner {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  category    String // PRINCIPAL | OFFICIEL | SPONSOR | INSTITUTIONNEL
  logoUrl     String
  description String?
  websiteUrl  String?
  order       Int    @default(0)
}

// ---------------------------------------------------------------------------
// ESPACE PRESSE
// ---------------------------------------------------------------------------

model PressItem {
  id          String   @id @default(cuid())
  type        String // COMMUNIQUE | CONFERENCE | INTERVIEW | PHOTO | LOGO | DOSSIER
  title       String
  description String?
  fileUrl     String?
  publishedAt DateTime @default(now())
}

model PressContact {
  id    String @id @default(cuid())
  name  String
  role  String
  email String
  phone String
}

model MediaEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
}

// ---------------------------------------------------------------------------
// CANDIDATURES (RECRUTEMENT & ACADEMY)
// ---------------------------------------------------------------------------

model RecruitmentApplication {
  id        String   @id @default(cuid())
  category  String // JOUEUR | EDUCATEUR | STAFF | ADMINISTRATION | BENEVOLE
  fullName  String
  email     String
  phone     String
  message   String?
  cvUrl     String?
  status    String   @default("NOUVEAU") // NOUVEAU | EN_COURS | TRAITE
  createdAt DateTime @default(now())
}

model AcademyApplication {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  birthDate        DateTime
  nationality      String
  position         String
  preferredFoot    String?
  height           Int?
  videoUrl         String?
  category         String // U13 | U15 | U17 | U18
  parentName       String
  parentEmail      String
  parentPhone      String
  parentalConsent  Boolean  @default(false)
  message          String?
  status           String   @default("NOUVEAU")
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// NEWSLETTER / NOTIFICATIONS / STATISTIQUES
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  icon      String   @default("🔔")
  title     String
  body      String
  url       String?
  createdAt DateTime @default(now())
}

model PageView {
  id   String   @id @default(cuid())
  path String
  date DateTime @default(now())

  @@index([date])
}
