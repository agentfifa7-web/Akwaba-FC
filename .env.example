# URL de connexion Postgres (Neon, Vercel Postgres, Supabase...).
# En local, créez un projet gratuit sur https://neon.tech (ou utilisez
# l'intégration Neon proposée par Vercel lors de l'import du projet) et
# collez ici la "connection string" fournie.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clé de signature des sessions admin (JWT). Générer une valeur aléatoire :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Compte super administrateur créé par `pnpm db:seed`.
SEED_ADMIN_EMAIL="admin@akwabafc.ci"
SEED_ADMIN_PASSWORD="change-me"
