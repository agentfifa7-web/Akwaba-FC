# SQLite en local (par défaut). Pour la production, remplacer par une URL
# Postgres et passer `provider = "postgresql"` dans prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Clé de signature des sessions admin (JWT). Générer une valeur aléatoire :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Compte super administrateur créé par `pnpm db:seed`.
SEED_ADMIN_EMAIL="admin@akwabafc.ci"
SEED_ADMIN_PASSWORD="change-me"
